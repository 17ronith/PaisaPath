    "framings": {
      "default": {
        "title": "REFUND?",
        "speaker": "UPI request",
        "place": "home",
        "text": "'Refund of ₹299 for your order! Approve this request with your UPI PIN to receive it.'"
      },
      "earner": {
        "title": "REFUND?",
        "speaker": "'Customer'",
        "place": "kirana",
        "text": "A 'customer' says he overpaid you and sends a request: 'Approve with your PIN to get my refund.'"
      }
    },
    "choices": [
      {
        "id": "approve",
        "text": "APPROVE WITH PIN",
        "quality": "weak",
        "effects": [
          {
            "label": "₹299 left your account instead",
            "wallet": -299,
            "happiness": -15
          }
        ],
        "scam": "fell",
        "lesson": "Entering your PIN always SENDS money. A refund never needs your PIN."
      },
      {
        "id": "decline",
        "text": "DECLINE IT",
        "quality": "good",
        "effects": [
          {
            "label": "Declined the request",
            "happiness": 4
          }
        ],
        "scam": "spotted",
        "ncfe": [
          {
            "item": "takes_responsibility",
            "value": 1
          }
        ],
        "lesson": "Right! A PIN means money going out. You never need it to receive."
      }
    ]
  },
