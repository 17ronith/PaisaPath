{
  "name": "learning-money-by-living-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team 97 — Megathon X. Pixel-art financial-literacy life sim.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "validate:content": "tsx src/content/validate.ts",
    "sim": "tsx src/engine/scripts/simulate.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:content",
    "server": "npm --prefix server run dev"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "phaser": "^3.90.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
